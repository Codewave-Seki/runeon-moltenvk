 // require yet more munging of the indirect buffers...
 static const uint32_t kMVKMaxDrawIndirectVertexCount = 1024 * KIBI;
 
+// Downstream change (not in upstream MoltenVK): a cap on the Metal draws encoded for one vkCmdDraw[Indexed]IndirectCount.
+// MoltenVK encodes maxDrawCount Metal indirect draws on the CPU for every such command and zeroes the unused ones on the
+// GPU, so a large maxDrawCount costs CPU time per draw even when few are real. The cap is read at encode time, so a
+// command buffer submitted again gets the current cap. A conversion kernel counts the commands whose real count exceeded
+// their cap, and each increase seen here doubles the cap for later encodes. It is never lowered.
+// Residual: the first time a real count exceeds the cap, draws can be missing until the raise takes effect.
+// A prefilled command buffer keeps the cap of its encode for that one submission; later submissions encode again.
+// MVK_PERF_ICOUNT_MAX_DRAWS sets the initial cap (default 256); 0 disables the cap and its counter.
+static std::atomic<uint32_t>& indirectCountCap() {
+	static std::atomic<uint32_t> cap { [] {
+		double n = mvkGetEnvVarNumber("MVK_PERF_ICOUNT_MAX_DRAWS", 256);
+		return n >= 1 ? (uint32_t)std::min(n, (double)UINT32_MAX) : 0u;
+	}() };
+	return cap;
+}
+
+// ponytail: one process-wide counter, bound to the first MTLDevice that needs it and never released.
+// Other devices get no cap at all; a per-device counter is the fix if that ever matters.
+static id<MTLBuffer> indirectCountTruncationCounter(id<MTLDevice> mtlDevice) {
+	static id<MTLBuffer> counter = [mtlDevice newBufferWithLength: sizeof(uint32_t)
+														  options: MTLResourceStorageModeShared | MTLResourceHazardTrackingModeUntracked];
+	return counter.device == mtlDevice ? counter : nil;
+}
+
+static void raiseIndirectCountCapIfTruncated(id<MTLBuffer> counter) {
+	static std::atomic<uint32_t> lastSeen {0};
+	uint32_t seen = *(const volatile uint32_t*)counter.contents;	// the GPU may lag a little; the next look catches up
+	if (lastSeen.exchange(seen, std::memory_order_relaxed) == seen) { return; }
+
+	uint32_t cap = indirectCountCap().load(std::memory_order_relaxed);
+	uint32_t raised = cap > UINT32_MAX / 2 ? UINT32_MAX : cap * 2;
+	indirectCountCap().store(raised, std::memory_order_relaxed);
+	fprintf(stderr, "[mvk-perf] indirect-count draw cap raised from %u to %u after truncated draws\n", cap, raised);
+}
+
+// The number of Metal draws to encode now for an indirect-count command with this maxDrawCount.
+static uint32_t cappedIndirectDrawCount(id<MTLDevice> mtlDevice, uint32_t maxDrawCount) {
+	uint32_t cap = indirectCountCap().load(std::memory_order_relaxed);
+	if ( !cap || maxDrawCount <= cap ) { return maxDrawCount; }
+	id<MTLBuffer> counter = indirectCountTruncationCounter(mtlDevice);
+	if ( !counter ) { return maxDrawCount; }
+	raiseIndirectCountCapIfTruncated(counter);
+	return std::min(maxDrawCount, indirectCountCap().load(std::memory_order_relaxed));
+}
