     /** Get a temporary MTLBuffer that will be returned to a pool after the command buffer is finished. */
     const MVKMTLBufferAllocation* getTempMTLBuffer(NSUInteger length, bool isPrivate = false, bool isDedicated = false);
 
+	/** Downstream change (not in upstream MoltenVK): an indirect-count conversion encoded before its command's render pass. */
+	struct HoistedIndirectCount {
+		const MVKMTLBufferAllocation* converted = nullptr;
+		uint32_t drawCount = 0;
+	};
+
+	/** Records a conversion encoded before the command's render pass, with the draw count it was sized for. */
+	void addHoistedIndirectCount(const MVKCommand* cmd, HoistedIndirectCount hoisted) { _hoistedIndirectCounts[cmd] = hoisted; }
+
+	/** Returns and forgets the conversion encoded before the render pass for this command, if any. */
+	HoistedIndirectCount takeHoistedIndirectCount(const MVKCommand* cmd) {
+		auto it = _hoistedIndirectCounts.find(cmd);
+		if (it == _hoistedIndirectCounts.end()) { return {}; }
+		auto hoisted = it->second;
+		_hoistedIndirectCounts.erase(it);
+		return hoisted;
+	}
+
 	/** Copy the bytes to a temporary MTLBuffer that will be returned to a pool after the command buffer is finished. */
 	const MVKMTLBufferAllocation* copyToTempMTLBufferAllocation(const void* bytes, NSUInteger length, bool isDedicated = false);
 
