+// Downstream change (not in upstream MoltenVK): before dynamic rendering begins, encode the indirect-count conversions of
+// its draws in one compute encoder, so none of them has to end and restart the Metal render pass. Stops at the end of the
+// pass, or at a command that could make new indirect arguments visible within it; later draws convert in place. So do
+// multiview passes after the first, and immediate encoding, where the following commands are not recorded yet.
+// MVK_PERF_HOIST_INDIRECT_COUNT=0 converts every draw in place.
+void MVKCommandEncoder::hoistIndirectCounts(MVKCommand* firstInRenderPass) {
+	static const bool enabled = mvkGetEnvVarNumber("MVK_PERF_HOIST_INDIRECT_COUNT", 1) != 0;
+	if ( !enabled || _mtlRenderEncoder ) { return; }
+	for (MVKCommand* cmd = firstInRenderPass; cmd && !cmd->endsRenderPass() && !cmd->blocksIndirectCountHoist(); cmd = cmd->_next) {
+		cmd->hoistIndirectCount(this);
+	}
+}
+
 void MVKCommandEncoder::encodeCommandsImpl(MVKCommand* command) {
     while(command) {
         uint32_t prevMVPassIdx = _multiviewPassIndex;
+		if (command->beginsDynamicRendering()) { hoistIndirectCounts(command->_next); }
         command->encode(this);
 
         if(_multiviewPassIndex > prevMVPassIdx) {
