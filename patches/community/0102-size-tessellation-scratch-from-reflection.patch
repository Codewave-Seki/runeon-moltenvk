+// Downstream change (not in upstream MoltenVK): clamp a tessellated indirect draw to the
+// vertex count that the scratch buffers are sized for, instead of writing past them.
+static void clampTessDraw(thread uint32_t& vertexCount, thread uint32_t& instanceCount,
+                          uint32_t inControlPointCount, uint32_t maxVertexCount) {
+	if ((ulong)vertexCount * instanceCount <= maxVertexCount) { return; }
+	if (vertexCount > maxVertexCount) {
+		vertexCount = maxVertexCount / inControlPointCount * inControlPointCount;	// whole patches only
+		instanceCount = min(instanceCount, 1u);
+	} else {
+		instanceCount = maxVertexCount / vertexCount;
+	}
+}
+
